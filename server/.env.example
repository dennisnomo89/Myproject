# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Development uses SQLite (no install needed). For MySQL set DB_DIALECT=mysql and fill in the rest.
DB_DIALECT=sqlite
DB_STORAGE=./data/dev.sqlite

DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_management
DB_USER=root
DB_PASSWORD=

# Email notifications. Leave SMTP_HOST empty in development: emails are then only
# recorded in the app's Email Log instead of being sent.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=your address, SMTP_PASS=an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Global Virgins Montessori Academy <no-reply@example.com>"
# Address of the web app, used for links inside emails.
APP_URL=http://localhost:5173

# Data backup: folder for backup files, hours between automatic backups, and how many automatic backups to keep.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Signs login sessions. In production this MUST be a long random string, or the server refuses to start.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Users are signed out after this long without activity (the app refreshes the session while they are active).
JWT_EXPIRES_IN=30m

# Brute-force protection: failed sign-ins per email and address, and reset requests per address, every 15 minutes.
LOGIN_ATTEMPTS_PER_15_MIN=10
RESET_REQUESTS_PER_15_MIN=5

# Production only. Set to 1 when the app runs behind a reverse proxy (Nginx, Caddy, a hosting platform),
# so sign-in limits see each user's real address instead of the proxy's.
TRUST_PROXY=
# Where the built web app is (npm run build in client/). The API serves it, so only one server is needed.
CLIENT_DIST=../client/dist
