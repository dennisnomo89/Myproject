{
  // Run and Debug panel (Ctrl+Shift+D): pick a configuration, then press F5.
  // Set breakpoints by clicking left of a line number.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/src/server.js",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug all API tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/node_modules/jest/bin/jest.js",
      "args": ["--runInBand"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug the open test file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "${relativeFile}"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug web app in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client",
      "preLaunchTask": "App: start web app"
    }
  ],
  "compounds": [
    {
      "name": "Debug API + web app",
      "configurations": ["Debug API", "Debug web app in Edge"],
      "stopAll": true
    }
  ]
}
